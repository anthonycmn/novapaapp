# dependencies
/node_modules

# Claude Code worktrees. These are full copies of the repo living inside the
# repo, so anything that walks the tree — `eslint .`, and the Netlify source
# upload — picks up a second, stale copy of every source file.
/.claude/worktrees/

# Netlify source-upload packages, ~250MB each.
/deploy-*.zip

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files — .env.example is the only one committed
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# vercel
.vercel

# typescript
*.tsbuildinfo

# test
coverage/

# local mock-data persistence (dev only)
.dev-data/
