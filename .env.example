# â”€â”€ Data mode â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# "mock" runs the app entirely on the in-process mock backend with seed data â€”
# no external services needed. Set to "supabase" once the Supabase project
# exists and the three keys below are filled in.
NEXT_PUBLIC_DATA_MODE=mock

# â”€â”€ Supabase â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Get these from supabase.com â†’ your project â†’ Settings â†’ API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# â”€â”€ Email (Resend) â€” Phase 2 â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# resend.com â†’ API Keys. Sending domain must be verified (SPF/DKIM).
RESEND_API_KEY=
EMAIL_FROM_ADDRESS="NOVA Performing Arts <hello@example.org>"

# â”€â”€ Scheduled jobs â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Shared secret for the Netlify scheduled functions in netlify/functions/*.mjs,
# which call their /api/jobs/* route with it in an x-cron-secret header:
#   email-queue (every 15 min)  push-queue (every 5 min)  casting-reminders  ical-sync  schedule-sync
# Generate any long random string; Netlify env and the app read the same one.
# Leave this unset and every job answers 401 â€” silently, and forever, since
# nothing surfaces a cron that is being turned away. Scheduled email in
# particular just sits at "Scheduled" in the admin list and never goes out.
CRON_SECRET=

# â”€â”€ Web Push â€” Phase 2 â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Generate once with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# â”€â”€ Stripe â€” Phase 5 (spirit buttons store) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# dashboard.stripe.com â†’ Developers â†’ API keys (use test keys first)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# â”€â”€ SmugMug â€” Phase 6 (photo galleries) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# api.smugmug.com â†’ apply for an API key with the org account.
# All four are needed (OAuth 1.0a); with any missing, the mock gallery is used.
SMUGMUG_API_KEY=
SMUGMUG_API_SECRET=
SMUGMUG_OAUTH_TOKEN=
SMUGMUG_OAUTH_SECRET=

# â”€â”€ Face matching â€” Phase 6 â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Self-hosted InsightFace embedding service (see DECISIONS.md for why
# self-hosted). Contract:
#   POST {image_url} -> {faces:[{embedding:number[512], confidence, box}]}
# Unset = deterministic mock vectors, and the admin page says so.
FACE_SERVICE_URL=
FACE_SERVICE_KEY=

# Shared secret so a cron job can trigger POST /api/photos/ingest.
PHOTO_JOB_SECRET=

# â”€â”€ Registration portal â€” Phase 4 â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Base URL + API key of the org's own registration system. While these are
# blank the app runs on mock registration data and says so in the admin sync
# view. Field mapping lives in src/lib/api/registration/custom.ts.
REGISTRATION_API_URL=
REGISTRATION_API_KEY=
# Shared secret for the inbound sync webhook (POST /api/registration/webhook).
# Generate any long random string; set the same value in the sender.
REGISTRATION_WEBHOOK_SECRET=
